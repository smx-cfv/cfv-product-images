{
  "name": "cfv-product-images",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "cross-env UV_THREADPOOL_SIZE=8 tsx src/guided-cli.ts",
    "media:process": "cross-env UV_THREADPOOL_SIZE=8 tsx src/cli.ts media:process",
    "media:uploads": "tsx src/cli.ts media:uploads",
    "media:upload": "tsx src/cli.ts media:uploads",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.848.0",
    "dotenv": "^17.2.0",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.14",
    "cross-env": "^10.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
